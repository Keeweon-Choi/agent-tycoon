const path = require('path');
const { spawn, spawnSync } = require('child_process');
const backupCli = require('./cld-gui-backup');
const { CLI_NAME: CLI, LEGACY_CLI_NAME: LEGACY } = require('./cld-brand');
const { configDirectory } = require('../../core/src/cld/configPath.cjs');
const controlIdentity = require('../../core/src/cld/controlIdentity.cjs');
const maintenance = require('./cld-gui-maintenance');

const HOME = os.homedir();
const CONFIG = configDirectory(HOME);
const COMMANDS = ['version', 'status', 'doctor', 'logs', 'restart', 'backup', 'restore', 'send', 'groups', 'job', 'jobs', 'stop', 'renew', 'rename', 'project', 'login', 'codex', 'gpu', 'hw', 'task', 'worker', 'trust', 'move-pty', 'permission-hook', 'worktree', 'install', 'update', 'rollback', 'uninstall', 'open', 'revert-adopt', 'start', 'start-policy'];
/** The manager (cld/install/manager.mjs, H §2): install, update, open, and the install part of status. */
const manager = () => import(require('url').pathToFileURL(path.join(__dirname, '..', 'install', 'manager.mjs')).href);
/** The GPU wrapper and Codex worker of this checkout (built with the daemon). */
const WORKER = path.join(__dirname, '..', '..', 'dist', 'cld-worker.js');
const TEXT_MAX = 32 * 1024;
/** Our product version (cld/release/version.json, the one source; not the root package.json). */
function productVersion() {
  try {
    return require(path.join(__dirname, '..', 'release', 'version.json')).version;
  } catch {
    return null;
  }
}
const NAME_RE = /^[A-Za-z0-9가-힣][A-Za-z0-9가-힣._-]{0,40}$/;
/** Exit codes besides 0 (ok) and 1 (refused or failed). */
const EXIT = { usage: 2, unknown_command: 2, not_yet: 2, daemon_off: 3 };
const USAGE = `사용법:
  ${CLI} send [--if-idle] [--from <이름>] <프로젝트> <메시지>
