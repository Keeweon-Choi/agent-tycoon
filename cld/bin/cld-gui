#!/usr/bin/env node
// cld-gui: the agent CLI of the agty engine (T-0019). The contract, with
// exit codes and JSON shapes, is cld/docs/design/cld-cli.md.
//
//   agty send [--if-idle] [--from <name>] <project> <message…> | send --group <room> [--from <name>] <message…>
//   agty groups | groups read <room> [-n N]
//   agty job [-t] [-d <description>] [--project <name>] [--gpu [--vram GiB] [--exclusive] [--label …]] <command…>
//   agty jobs [--all]
//   agty stop <job id|pid>
//   agty renew [--project <name>] [<handoff file> | -]
//   agty rename [--project <name>] <new name>  (RENAME: after the turn, every record follows)
//   agty project remove <name> [--purge]
//   agty codex [-m <model>] [-e <effort>] [-d <description>] [--worktree [--name <type/scope-what>]] [--project <name>] <spec file> | codex [--all]
//   agty gpu [--json] | gpu run [opts] -- <command…> | gpu cancel <id> | gpu move <id> <n>
//   agty hw [--json]
//   agty task add|update|done|show|list|import …  (작업 현황, DEV-BOARD; D6 Task store)
//   agty trust [--start] <project or folder>  (AUTO-TRUST: Claude's folder trust question)
//   agty worktree new --task <id> [--assign <name>] [--base <branch>] | worktree list [--task <id>]  (W2)
//   agty version | login […] | help
//
// It talks to the daemon over ~/.config/agent-tycoon/engine.sock (Windows:
// \\.\pipe\cld-gui-engine-<user>). When the daemon is off, `send` leaves the
// message in ~/.config/agent-tycoon/queue/ for it (the daemon resumes that queue).
